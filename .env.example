# Base URL of the content/auth API, without a trailing slash.
# Local development: put this in .env.local (git-ignored).
# Production: set it in Vercel → Project → Settings → Environment Variables,
# and add the same origin to connect-src in vercel.json.
VITE_API_URL=

# Serve the API from the in-browser mock (src/lib/api/mock.js) instead of a
# server. Defaults to true while VITE_API_URL is empty; set to false to force
# the "API not configured" screen, or to true to demo against the mock even
# when VITE_API_URL is set.
# VITE_USE_MOCK_API=true
